# Supabase — required for auth, profiles, and chart persistence
# Anonymous readings work without these (calculation is local)
NEXT_PUBLIC_SUPABASE_URL=              # e.g. https://abc123.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=         # Public anon key from Supabase dashboard
SUPABASE_SERVICE_ROLE_KEY=             # Service role key (server-side only, never expose)

# Site URL — used for auth email redirect URLs (confirmation, password reset)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
